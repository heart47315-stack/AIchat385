{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "bundler",
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "prisma", "*.config.ts"]
}