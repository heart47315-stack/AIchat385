{
  "compilerOptions": {
    "target": "ES2020",                       // ใช้ฟีเจอร์ JS ถึง ES2020
    "module": "commonjs",                     // ใช้ CommonJS (เหมาะกับ Node.js)
    "moduleResolution": "node",               // วิธี resolve module แบบ Node
    "esModuleInterop": true,                  // import default จาก CommonJS ได้
    "allowSyntheticDefaultImports": true,     // import default จาก CommonJS ได้สะดวกขึ้น
    "resolveJsonModule": true,                // import ไฟล์ .json ได้
    "outDir": "dist",                         // โฟลเดอร์ที่เก็บไฟล์ build
    "strict": true,                           // เปิด strict mode ตรวจ error มากขึ้น
    "skipLibCheck": true,                     // ข้ามการตรวจสอบ type ของ library
    "forceConsistentCasingInFileNames": true  // ป้องกันปัญหา case-sensitive บน Linux
  },
  "include": ["src"]
}
